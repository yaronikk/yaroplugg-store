# TODO: add the public Supabase project URL and publishable key for local development.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public Cloudflare Turnstile site key; keep the matching secret in Supabase Function secrets.
VITE_TURNSTILE_SITE_KEY=
# Optional Instagram profile, displayed on the INFO page.
VITE_INSTAGRAM_URL=
# Optional Umami Cloud script URL and website ID; leave empty to disable analytics.
VITE_ANALYTICS_SCRIPT_URL=
VITE_ANALYTICS_WEBSITE_ID=
# Public site URL used by server routes and Edge Functions; do not derive it from Host.
SHOP_SITE_URL=
